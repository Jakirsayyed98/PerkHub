<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/mainlayout"
    tools:context=".Screens.withdrawal.WithdrawalFlowFragment">

    <LinearLayout
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_layout" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:text="Available Balance"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="@dimen/sp18" />

    <TextView
        android:id="@+id/availbaleAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="250rs"
        android:textAlignment="center"
        android:textColor="@color/green"
        android:textSize="@dimen/sp35"
        android:textStyle="bold"
        />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:text="Withdrawal Amount"
        android:paddingStart="@dimen/dp20"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="@dimen/sp18" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/numberlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_marginStart="@dimen/dp15"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp15"
        android:textAlignment="center"
        android:textColorHint="@color/grey"
        app:boxStrokeColor="@color/black"
        app:hintEnabled="false"
        app:hintTextColor="@color/black"
        >

        <EditText
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:imeOptions="actionDone"
            android:background="@drawable/border_5dp"
            android:inputType="number"
            android:hint="0.00"
            android:maxLength="5"
            android:paddingStart="@dimen/dp25"/>

    </com.google.android.material.textfield.TextInputLayout>



    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:text="Minimum withdrawal: $10.00"
        android:paddingStart="@dimen/dp20"
        android:textColor="@color/black"
        android:textSize="@dimen/sp14" />

    <RelativeLayout
        android:id="@+id/continuebtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginStart="@dimen/dp45"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginEnd="@dimen/dp45"
        android:layout_marginBottom="@dimen/dp20"
        android:background="@drawable/selected_button_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/numberlayout">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Continue"
            android:textColor="@color/btn_text"
            android:textStyle="bold" />

    </RelativeLayout>

</LinearLayout>