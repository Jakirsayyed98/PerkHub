<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Screens.withdrawal.WithdrawalFlowFragment">

    <!-- Toolbar -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_layout" />

    <!-- Available Balance Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:text="Available Balance"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="@dimen/sp18" />

    <!-- Available Balance Amount -->
    <TextView
        android:id="@+id/availableAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:hint="₹250"
        android:textAlignment="center"
        android:textColor="@color/green"
        android:textSize="@dimen/sp35"
        android:textStyle="bold" />

    <!-- Withdrawal Amount Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp25"
        android:paddingStart="@dimen/dp20"
        android:text="Withdrawal Amount"
        android:textColor="@color/black"
        android:textSize="@dimen/sp18"
        android:textStyle="bold" />

    <!-- Amount Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/amountLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp15"
        android:hint="₹"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp15"
        app:boxStrokeColor="@color/black"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:background="@drawable/border_5dp"
            android:hint="₹100"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="5"
            android:paddingStart="@dimen/dp25" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Minimum Withdrawal Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:paddingStart="@dimen/dp20"
        android:text="Minimum withdrawal amount is ₹100"
        android:textColor="@color/black"
        android:textSize="@dimen/sp14" />

    <!-- Continue Button -->
    <RelativeLayout
        android:id="@+id/continueBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginStart="@dimen/dp45"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginEnd="@dimen/dp45"
        android:layout_marginBottom="@dimen/dp20"
        android:background="@drawable/border_5dp"
        android:backgroundTint="@color/withdraw_button_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Continue"
            android:textColor="@color/btn_text"
            android:textStyle="bold" />
    </RelativeLayout>

</LinearLayout>
