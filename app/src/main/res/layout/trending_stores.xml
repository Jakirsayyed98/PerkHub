<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp170"
    android:layout_height="@dimen/dp130"
    android:layout_marginHorizontal="@dimen/dp5"
    android:paddingEnd="@dimen/dp5"
    android:background="@drawable/bg_store_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dp16">

        <!-- Logo + Store Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgStoreLogo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp45"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_background"
                android:contentDescription="@null"/>

        </LinearLayout>

        <!-- Space -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp15"/>

        <!-- Up To -->
        <TextView
            android:id="@+id/txtOffer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up to"
            android:textColor="@color/black"
            app:fontFamily="@font/poppins_semibold"
            android:textSize="@dimen/sp12"/>

        <!-- Cashback -->
        <TextView
            android:id="@+id/txtCashback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8% Cashback"
            android:textColor="#14A38B"
            android:textSize="@dimen/sp15"
            app:fontFamily="@font/poppins_bold"/>

    </LinearLayout>

</RelativeLayout>