<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainlayout"
    android:orientation="vertical"
    tools:context=".Screens.Profile.NewTicketFragment">
        <!-- Toolbar -->
        <LinearLayout
            android:id="@+id/toolbar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar_layout"/>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Main Content Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="-2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="24dp">

                        <!-- Subject -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Subject *"
                            android:textColor="#191621"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:labelFor="@id/subject" />

                        <EditText
                            android:id="@+id/subject"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/ticket_input_background"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:hint="Enter ticket subject"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:imeOptions="actionNext"
                            android:textColor="#191621"
                            android:textColorHint="#777382"
                            android:textSize="15sp"
                            android:importantForAutofill="no" />

                        <!-- Category -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:text="Category *"
                            android:textColor="#191621"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:labelFor="@id/category" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="10dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1dp"
                            android:layout_marginHorizontal="@dimen/dp1">

                            <Spinner
                                android:id="@+id/category"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp"
                                android:spinnerMode="dropdown"
                                android:backgroundTint="#D8D2E4"
                                android:contentDescription="Select ticket category" />

                        </androidx.cardview.widget.CardView>

                        <!-- Priority -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:text="Priority *"
                            android:textColor="#191621"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/priorityGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <RadioButton
                                android:id="@+id/low"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/ticket_priority_low"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:text="Low"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:minWidth="0dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/medium"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1.15"
                                android:layout_marginHorizontal="2dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/ticket_priority_medium"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:text="Medium"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:checked="true"
                                android:minWidth="0dp"
                                android:minHeight="48dp" />

                            <RadioButton
                                android:id="@+id/high"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/ticket_priority_high"
                                android:paddingStart="2dp"
                                android:paddingEnd="2dp"
                                android:text="High"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:minWidth="0dp"
                                android:minHeight="48dp" />

                        </RadioGroup>

                        <!-- Description -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:text="Description *"
                            android:textColor="#191621"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:labelFor="@id/description" />

                        <EditText
                            android:id="@+id/description"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/ticket_input_background"
                            android:gravity="top|start"
                            android:padding="14dp"
                            android:hint="Describe your issue in detail..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500"
                            android:minLines="4"
                            android:maxLines="8"
                            android:imeOptions="actionDone"
                            android:scrollbars="vertical"
                            android:overScrollMode="ifContentScrolls"
                            android:textColor="#191621"
                            android:textColorHint="#777382"
                            android:textSize="15sp" />

                        <!-- Character Limit -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Maximum 500 characters"
                            android:textColor="#777382"
                            android:textSize="12sp" />

                        <!-- Submit Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/createTicketBtn"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/selected_button_layout"
                            android:backgroundTint="#7217B7"
                            android:text="Submit Ticket"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:minHeight="56dp"
                            android:stateListAnimator="@null" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dp10"
                    app:cardCornerRadius="@dimen/dp10"
                    app:cardBackgroundColor="@color/protipbg"
                    android:layout_marginHorizontal="@dimen/dp15"
                    android:layout_marginBottom="@dimen/dp24"
                    app:cardElevation="-2dp"
                    android:layout_marginTop="@dimen/dp15">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/protiptext"
                        android:textSize="@dimen/sp18"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="@dimen/dp15"
                        android:layout_marginTop="@dimen/dp15"
                        android:text="Tips for Better Support"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/protiptext"
                        android:textSize="@dimen/sp14"
                        android:layout_marginHorizontal="@dimen/dp15"
                        android:layout_marginVertical="@dimen/dp15"
                        android:textStyle="bold"
                        android:layout_gravity="center_vertical"
                        android:text="@string/tickets_notes"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
</LinearLayout>