<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/mainlayout"
    android:background="@color/BG_color"
    tools:context=".Screens.withdrawal.WalletFragment">

    <!-- Toolbar Section -->
    <LinearLayout
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_layout" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Balance Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="@dimen/dp8"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/light_blue"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp24">

                    <!-- Balance Amount -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        >

                        <ImageView
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"
                            android:src="@drawable/wallet"
                            app:tint="@color/white_87"
                            android:layout_marginEnd="@dimen/dp12" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available Balance"
                                android:textColor="@color/white_70"
                                android:textSize="14sp"
                                 />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="@dimen/dp4">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₹"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/available"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="150"
                                    android:textColor="@color/white"
                                    android:textSize="34sp"
                                    android:textStyle="bold"
                                    android:layout_marginStart="@dimen/dp4" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Available for withdrawal"
                        android:textColor="@color/white_87"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/dp8" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Statistics Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="@dimen/dp8">

                <!-- Pending Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp8"
                    app:cardCornerRadius="@dimen/dp16"
                    app:cardElevation="@dimen/dp4"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/pending_card_bg"
                    app:strokeColor="@color/pending_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp20"
                        android:gravity="center">

                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/dp38"
                            android:layout_height="@dimen/dp38"
                            app:cardCornerRadius="@dimen/dp12"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/pending_icon_bg"
                            android:layout_marginBottom="@dimen/dp12">

                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:layout_gravity="center"
                                android:src="@drawable/dashboard_icon"
                                app:tint="@color/pending_icon_tint" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/pending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/pending_text_primary"
                            android:layout_marginBottom="@dimen/dp4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textSize="14sp"
                            android:textColor="@color/pending_text_secondary" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Rejected Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp8"
                    app:cardCornerRadius="@dimen/dp16"
                    app:cardElevation="@dimen/dp4"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/rejected_card_bg"
                    app:strokeColor="@color/rejected_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp20"
                        android:gravity="center">

                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/dp38"
                            android:layout_height="@dimen/dp38"
                            app:cardCornerRadius="@dimen/dp12"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/rejected_icon_bg"
                            android:layout_marginBottom="@dimen/dp12">

                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:layout_gravity="center"
                                android:src="@drawable/bg_circle_grey"
                                app:tint="@color/rejected_icon_tint" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/rejected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/rejected_text_primary"
                            android:layout_marginBottom="@dimen/dp4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rejected"
                            android:textSize="14sp"
                            android:textColor="@color/rejected_text_secondary" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Withdraw Button -->
            <Button
                android:id="@+id/withdraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginHorizontal="@dimen/dp24"
                android:text="Withdraw Funds"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/dp14"
                android:background="@drawable/border_5dp"
                app:backgroundTint="@color/withdraw_button_bg"
                android:textColor="@color/white"
                app:icon="@drawable/dashboard_icon"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconSize="@dimen/dp20"
                android:elevation="@dimen/dp4"
                />

            <!-- History Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/dp32">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp12">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/dashboard_icon"
                            app:tint="@color/text_primary"
                            android:layout_marginEnd="@dimen/dp8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/withdrawal_history"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- View All Button -->
                    <Button
                        android:id="@+id/btnViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textSize="12sp"
                        android:background="@drawable/border_5dp"
                        android:backgroundTint="@color/primary_button_bg"
                        android:textColor="@color/white"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingVertical="@dimen/dp8"
                        android:paddingHorizontal="@dimen/dp12" />

                </LinearLayout>

                <!-- History Card Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Empty State (when no history) -->
                        <LinearLayout
                            android:id="@+id/emptyStateLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/dp40"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="@dimen/dp64"
                                android:layout_height="@dimen/dp64"
                                android:src="@drawable/outline_history_24"
                                app:tint="@color/text_disabled"
                                android:layout_marginBottom="@dimen/dp16" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No transactions yet"
                                android:textColor="@color/text_secondary"
                                android:textSize="16sp"
                                
                                android:layout_marginBottom="@dimen/dp4" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your withdrawal history will appear here"
                                android:textColor="@color/text_disabled"
                                android:textSize="14sp"
                                android:gravity="center" />

                        </LinearLayout>

                        <!-- RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/withdrawalhistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:scrollbars="none"
                            android:overScrollMode="never" />

                    </LinearLayout>
            </LinearLayout>

            <!-- Bottom Spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp20" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>