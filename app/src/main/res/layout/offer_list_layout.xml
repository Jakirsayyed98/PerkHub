<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp20"
    app:cardElevation="@dimen/dp4"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_header_bg"
            android:padding="@dimen/dp10">

            <!-- Store Icon -->
            <androidx.cardview.widget.CardView
                android:id="@+id/iconCard"
                android:layout_width="@dimen/dp60"
                android:layout_height="@dimen/dp60"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dp7"
                app:cardElevation="@dimen/dp3"
                app:cardUseCompatPadding="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/store_icon"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_placeholder" />

            </androidx.cardview.widget.CardView>

            <!-- Store Info -->
            <LinearLayout
                android:id="@+id/storeInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp10"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/iconCard"
                app:layout_constraintEnd_toStartOf="@id/trendingBadge"
                app:layout_constraintStart_toEndOf="@id/iconCard"
                app:layout_constraintTop_toTopOf="@id/iconCard">

                <TextView
                    android:id="@+id/storename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:text="@string/store_name"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp16"
                    tools:text="Nike Store" />

                <TextView
                    android:id="@+id/storeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp2"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="@string/offer"
                    android:textColor="@color/white_87"
                    android:textSize="@dimen/sp11"
                    tools:text="Fashion &amp; Lifestyle" />

            </LinearLayout>

            <!-- Hot Badge -->
            <androidx.cardview.widget.CardView
                android:id="@+id/trendingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pending_card_bg"
                app:cardCornerRadius="@dimen/dp12"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="@dimen/dp10"
                    android:paddingVertical="@dimen/dp4"
                    android:text="@string/hot_badge"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp9" />

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp16">

            <!-- Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingExtra="@dimen/dp2"
                    android:maxLines="2"
                    android:text="@string/offer_title"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp17"
                    tools:text="Get 50% OFF on All Sneakers" />

<!--                <ImageView-->
<!--                    android:layout_width="@dimen/dp22"-->
<!--                    android:layout_height="@dimen/dp22"-->
<!--                    android:layout_marginStart="@dimen/dp8"-->
<!--                    android:contentDescription="@string/offer_icon"-->
<!--                    android:src="@drawable/ic_star_sparkle"-->
<!--                    app:tint="@color/grey_dark" />-->

            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/dis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingExtra="@dimen/dp2"
                android:maxLines="5"
                android:text="@string/offer_description"
                android:textColor="@color/grey_dark"
                android:textSize="@dimen/sp13"
                tools:text="Grab the best deals on premium sneakers. Limited time offer!" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/dp16"
                android:background="@color/grey_dark" />

            <!-- Coupon Layout -->
            <androidx.cardview.widget.CardView
                android:id="@+id/couponlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/coupon_bg"
                app:cardCornerRadius="@dimen/dp16"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp14">

                    <!-- Coupon Icon -->
                    <ImageView
                        android:layout_width="@dimen/dp22"
                        android:layout_height="@dimen/dp22"
                        android:contentDescription="@string/coupon_code"
                        android:src="@drawable/ic_coupon_ticket"
                        app:tint="@color/grey_dark" />

                    <!-- Coupon Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/coupon_code"
                            android:textAllCaps="true"
                            android:textColor="@color/grey_dark"
                            android:textSize="@dimen/sp10" />

                        <TextView
                            android:id="@+id/couponCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp2"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="0.03"
                            android:text="@string/sample_coupon"
                            android:textColor="@color/grey_dark"
                            android:textSize="@dimen/sp16"
                            tools:text="NIKE50" />

                    </LinearLayout>

                    <!-- Copy Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/copy"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp40"
                        android:backgroundTint="@color/main"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingHorizontal="@dimen/dp12"
                        android:text="@string/tap_to_copy"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp10"
                        app:cornerRadius="@dimen/dp12"
                        app:icon="@drawable/ic_copy"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/dp6"
                        app:iconTint="@color/white" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Validity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp14"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:contentDescription="@string/valid_till"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/grey_dark" />

                <TextView
                    android:id="@+id/validTill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp6"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/valid_till"
                    android:textColor="@color/grey_dark"
                    android:textSize="@dimen/sp11"
                    tools:text="Valid till Dec 31, 2026" />

                <TextView
                    android:id="@+id/urgencyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/urgency_bg"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp4"
                    android:text="@string/days_left"
                    android:textColor="@color/urgency_red"
                    android:textSize="@dimen/sp10" />

            </LinearLayout>

            <!-- CTA -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/shop"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp50"
                android:layout_marginTop="@dimen/dp18"
                android:background="@drawable/gradient_cta_button"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/shop_now"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/sp14"
                app:cornerRadius="@dimen/dp14"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/dp8"
                app:iconTint="@color/white" />

            <!-- Social Proof -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp14"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp14"
                    android:layout_height="@dimen/dp14"
                    android:contentDescription="@string/users"
                    android:src="@drawable/ic_users"
                    app:tint="@color/grey_dark" />

                <TextView
                    android:id="@+id/usageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp6"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/people_used_today"
                    android:textColor="@color/grey_dark"
                    android:textSize="@dimen/sp11" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>