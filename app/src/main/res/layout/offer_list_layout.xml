<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/mainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="@dimen/dp12"
    android:layout_marginEnd="@dimen/dp12"
    android:layout_marginTop="@dimen/dp6"
    android:layout_marginBottom="@dimen/dp6"

    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp20"
    app:cardElevation="@dimen/dp2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp14">

        <!-- LEFT ACCENT -->
        <View
            android:id="@+id/accentLine"
            android:layout_width="@dimen/dp4"
            android:layout_height="0dp"

            android:background="@drawable/deal_accent_bg"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <!-- STORE LOGO -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"

            android:layout_marginStart="@dimen/dp10"

            android:background="@drawable/deal_logo_bg"
            android:padding="@dimen/dp7"

            android:scaleType="fitCenter"
            android:contentDescription="@string/store_icon"

            app:layout_constraintStart_toEndOf="@id/accentLine"
            app:layout_constraintTop_toTopOf="parent"

            tools:src="@drawable/ic_placeholder" />


        <!-- STORE NAME -->
        <TextView
            android:id="@+id/storename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="@dimen/dp9"
            android:layout_marginEnd="@dimen/dp8"

            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:ellipsize="end"

            android:includeFontPadding="false"

            android:text="@string/store_name"
            android:textColor="@color/black"
            android:textSize="@dimen/sp12"

            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintEnd_toStartOf="@id/trendingBadge"
            app:layout_constraintTop_toTopOf="@id/icon"

            tools:text="Myntra" />


        <!-- STORE TYPE -->
        <TextView
            android:id="@+id/storeType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="@dimen/dp9"
            android:layout_marginEnd="@dimen/dp8"
            android:layout_marginTop="@dimen/dp2"

            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:ellipsize="end"

            android:includeFontPadding="false"

            android:text="@string/offer"
            android:textColor="#929292"
            android:textSize="@dimen/sp8"

            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintEnd_toStartOf="@id/trendingBadge"
            app:layout_constraintTop_toBottomOf="@id/storename"

            tools:text="Fashion &amp; Lifestyle" />


        <!-- STATUS BADGE -->
        <TextView
            android:id="@+id/trendingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:background="@drawable/deal_badge_bg"

            android:fontFamily="@font/poppins_bold"

            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8"
            android:paddingTop="@dimen/dp4"
            android:paddingBottom="@dimen/dp4"

            android:text="HOT"
            android:textAllCaps="true"
            android:textColor="@color/main"
            android:textSize="@dimen/sp7"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- OFFER TITLE -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/dp13"

            android:fontFamily="@font/poppins_bold"

            android:includeFontPadding="false"

            android:maxLines="2"
            android:ellipsize="end"

            android:lineSpacingExtra="0dp"

            android:text="@string/offer_title"
            android:textColor="#151515"
            android:textSize="@dimen/sp18"

            app:layout_constraintStart_toEndOf="@id/accentLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icon"

            tools:text="FLAT 50% OFF\nON YOUR NEXT ORDER" />


        <!-- DESCRIPTION -->
        <TextView
            android:id="@+id/dis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/dp5"

            android:fontFamily="@font/poppins_regular"

            android:includeFontPadding="false"

            android:maxLines="2"
            android:ellipsize="end"

            android:text="@string/offer_description"
            android:textColor="#777777"
            android:textSize="@dimen/sp9"

            app:layout_constraintStart_toEndOf="@id/accentLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"

            tools:text="Get your favourite styles at a much better price." />


        <!-- ACTION AREA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomRow"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp42"

            android:layout_marginTop="@dimen/dp13"

            app:layout_constraintStart_toEndOf="@id/accentLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dis">


            <!-- COUPON TICKET -->
            <LinearLayout
                android:id="@+id/couponlayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:background="@drawable/deal_coupon_bg"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp5"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/shop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">


                <ImageView
                    android:id="@+id/couponIcon"
                    android:layout_width="@dimen/dp18"
                    android:layout_height="@dimen/dp18"

                    android:src="@drawable/ic_coupon_ticket"

                    app:tint="@color/main" />


                <TextView
                    android:id="@+id/couponCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="@dimen/dp7"

                    android:layout_weight="1"

                    android:fontFamily="@font/poppins_bold"

                    android:maxLines="1"
                    android:ellipsize="middle"

                    android:includeFontPadding="false"

                    android:text="@string/sample_coupon"
                    android:textColor="#171717"
                    android:textSize="@dimen/sp10"

                    tools:text="SAVE50" />


                <TextView
                    android:id="@+id/copyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginEnd="@dimen/dp5"

                    android:fontFamily="@font/poppins_bold"

                    android:text="COPY"
                    android:textColor="@color/main"
                    android:textSize="@dimen/sp7" />


                <ImageView
                    android:id="@+id/copy"
                    android:layout_width="@dimen/dp28"
                    android:layout_height="@dimen/dp28"

                    android:padding="@dimen/dp7"

                    android:src="@drawable/ic_copy"

                    app:tint="@color/main" />

            </LinearLayout>


            <!-- SHOP BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/shop"

                android:layout_width="@dimen/dp94"
                android:layout_height="match_parent"

                android:layout_marginStart="@dimen/dp7"

                android:background="@drawable/deal_shop_bg"

                android:fontFamily="@font/poppins_bold"

                android:minWidth="0dp"
                android:minHeight="0dp"

                android:paddingStart="@dimen/dp8"
                android:paddingEnd="@dimen/dp8"

                android:text="SHOP  →"
                android:textAllCaps="false"

                android:textColor="@color/white"
                android:textSize="@dimen/sp9"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- EXPIRY -->
        <LinearLayout
            android:id="@+id/validityLayout"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/dp9"

            android:gravity="center_vertical"
            android:orientation="horizontal"

            app:layout_constraintStart_toEndOf="@id/accentLine"
            app:layout_constraintTop_toBottomOf="@id/bottomRow">


            <ImageView
                android:layout_width="@dimen/dp12"
                android:layout_height="@dimen/dp12"

                android:src="@drawable/ic_clock"

                app:tint="#999999" />


            <TextView
                android:id="@+id/validTill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="@dimen/dp4"

                android:fontFamily="@font/poppins_medium"

                android:text="@string/valid_till"

                android:textColor="#8A8A8A"
                android:textSize="@dimen/sp8"

                tools:text="Valid till 30 Sep 2026" />

        </LinearLayout>


        <!-- URGENCY -->
        <TextView
            android:id="@+id/urgencyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/dp7"

            android:background="@drawable/deal_urgency_bg"

            android:fontFamily="@font/poppins_bold"

            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8"
            android:paddingTop="@dimen/dp4"
            android:paddingBottom="@dimen/dp4"

            android:text="2 DAYS LEFT"

            android:textColor="@color/urgency_red"
            android:textSize="@dimen/sp7"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bottomRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>