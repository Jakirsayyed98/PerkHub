<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp6"
    android:layout_marginHorizontal="@dimen/dp3"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp16"
    app:cardElevation="@dimen/dp1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/dp14">

        <!-- Store Logo -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/dp50"
            android:layout_height="@dimen/dp50"
            android:scaleType="centerInside"
            app:shapeAppearanceOverlay="@style/SearchStoreLogoStyle" />

        <!-- Store Information -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/storeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Mamaearth"
                    android:textColor="#101828"
                    android:textSize="@dimen/sp14"
                    android:fontFamily="@font/poppins_medium"
                    android:textStyle="bold" />


            </LinearLayout>

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Goodness of nature, inside and out."
                android:textColor="#101828"
                android:textSize="@dimen/sp11"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:id="@+id/featured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Featured"
                android:textColor="#008F63"
                android:textSize="@dimen/sp9"
                android:fontFamily="@font/poppins_medium"
                android:background="@drawable/bg_featured" />

        </LinearLayout>

        <!-- Cashback -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cashbackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upto"
                android:textColor="#101828"
                android:textSize="@dimen/sp10"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:id="@+id/cashbackValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19304.25%"
                android:textColor="#008F63"
                android:textSize="@dimen/sp13"
                android:fontFamily="@font/poppins_medium" />

            <TextView
                android:id="@+id/cashbackLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cashback"
                android:textColor="#101828"
                android:textSize="@dimen/sp10"
                android:fontFamily="@font/poppins_regular" />

        </LinearLayout>

        <!-- Arrow -->

        <ImageView
            android:layout_width="@dimen/sp15"
            android:layout_height="@dimen/sp15"
            android:src="@drawable/arrow_right"
            app:tint="#101828" />

    </LinearLayout>

</androidx.cardview.widget.CardView>