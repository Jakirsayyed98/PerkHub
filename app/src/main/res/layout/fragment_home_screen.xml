<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".Screens.Home.HomeScreenFragment">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainlayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- App Bar Layout with Modern Material Design -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
<!--        <LinearLayout-->
<!--            android:id="@+id/appBarLayout"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:fitsSystemWindows="true"-->
<!--            app:elevation="0dp">-->

            <!-- Modern Toolbar -->
<!--            <com.google.android.material.appbar.MaterialToolbar-->
<!--                android:id="@+id/toolbar"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:background="@color/light_blue"-->
<!--                android:minHeight="?attr/actionBarSize"-->
<!--                android:paddingHorizontal="@dimen/dp16"-->
<!--                android:paddingVertical="@dimen/dp8"-->
<!--                app:contentInsetStart="0dp"-->
<!--                app:layout_scrollFlags="scroll|enterAlways|snap">-->

                <LinearLayout
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="horizontal"
                    android:background="@color/light_blue"
                    android:paddingHorizontal="@dimen/dp16"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/dp8">

                    <!-- Profile Avatar with Status Indicator -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/profile"
                            android:layout_width="@dimen/dp48"
                            android:layout_height="@dimen/dp48"
                            app:cardCornerRadius="@dimen/dp24"
                            app:cardElevation="@dimen/dp4"
                            app:cardBackgroundColor="@color/profile_bg"
                            app:strokeWidth="2dp"
                            app:strokeColor="@color/profile_stroke">

                            <TextView
                                android:id="@+id/profileName"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="SM"
                                android:maxLength="2"
                                android:textColor="@color/profile_text"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                 />

                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                    <!-- Modern Search Bar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/dp16"
                        app:cardCornerRadius="@dimen/dp24"
                        app:cardElevation="@dimen/dp2"
                        app:cardBackgroundColor="@color/search_bg"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/search_stroke">

                        <LinearLayout
                            android:id="@+id/searchContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="@dimen/dp16"
                            android:paddingVertical="@dimen/dp12"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:src="@drawable/search"
                                app:tint="@color/search_icon_tint"
                                android:layout_marginEnd="@dimen/dp8" />

                            <TextView
                                android:id="@+id/search"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Search stores, offers..."
                                android:textColor="@color/search_hint_text"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Notification Bell with Badge -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/notificationContainer"
                            android:layout_width="@dimen/dp40"
                            android:layout_height="@dimen/dp40"
                            app:cardCornerRadius="@dimen/dp20"
                            app:cardElevation="@dimen/dp2"
                            app:cardBackgroundColor="@color/notification_bg"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:id="@+id/notification"
                                android:layout_width="@dimen/dp20"
                                android:layout_height="@dimen/dp20"
                                android:layout_gravity="center"
                                android:contentDescription="notification"
                                android:src="@drawable/notifications"
                                app:tint="@color/notification_icon_tint" />

                        </androidx.cardview.widget.CardView>

                        <!-- Notification Badge -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/notificationBadge"
                            android:layout_width="@dimen/dp16"
                            android:layout_height="@dimen/dp16"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="@dimen/dp2"
                            android:layout_marginEnd="@dimen/dp2"
                            app:cardCornerRadius="@dimen/dp8"
                            app:cardElevation="@dimen/dp1"
                            app:cardBackgroundColor="@color/notification_badge_bg"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/badgeCount"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                </LinearLayout>

<!--            </com.google.android.material.appbar.MaterialToolbar>-->

<!--        </LinearLayout>-->

        <!-- Main Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mainlayout1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/home_bg"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dp24">

                <!-- Modern Banner Section -->
                <LinearLayout
                    android:id="@+id/banner1layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp16">

                    <!-- Banner Card with Modern Design -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/bannerCard"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        app:cardCornerRadius="@dimen/dp20"
                        app:cardElevation="@dimen/dp8"
                        app:cardUseCompatPadding="true"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/bannerKocMarket"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clipToPadding="false"
                                android:clipChildren="false"
                                android:overScrollMode="never" />

                            <!-- Banner Indicator -->
                            <LinearLayout
                                android:id="@+id/bannerIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="@dimen/dp16"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/dp8"
                                android:paddingVertical="@dimen/dp4" />

                        </FrameLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Categories Section with Modern Styling -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/sectionCategories"
                        layout="@layout/section_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Trending Stores Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp20">

                    <include
                        android:id="@+id/sectionTrendingStores"
                        layout="@layout/section_trending_stores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Featured Banner with Modern Overlay -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/featuredBannerCard"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="@dimen/dp24"
                    app:cardCornerRadius="@dimen/dp20"
                    app:cardElevation="@dimen/dp6"
                    app:cardUseCompatPadding="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/banner2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/login_bg"
                            android:scaleType="centerCrop" />

                        <!-- Content Overlay -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/dp20">

                            <!-- Section Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/dp16">

                                <TextView
                                    android:id="@+id/titleTrendingStores"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="✨ Trending Now"
                                    android:textColor="@color/white"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:shadowColor="#80000000"
                                    android:shadowDx="0"
                                    android:shadowDy="2"
                                    android:shadowRadius="4" />

                                <androidx.cardview.widget.CardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:cardCornerRadius="@dimen/dp16"
                                    app:cardElevation="@dimen/dp2"
                                    app:cardBackgroundColor="@color/trending_badge_bg">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="HOT"
                                        android:textColor="@color/trending_badge_text"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:paddingHorizontal="@dimen/dp12"
                                        android:paddingVertical="@dimen/dp4" />

                                </androidx.cardview.widget.CardView>

                            </LinearLayout>

                            <!-- Trending Stores RecyclerView -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerTrendingStores1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:paddingVertical="@dimen/dp8"
                                android:overScrollMode="never" />

                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Popular Stores Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp24">

                    <include
                        android:id="@+id/sectionPopularStores"
                        layout="@layout/section_popular_stores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Popular Games Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp24">

                    <include
                        android:id="@+id/sectionPopularGames"
                        layout="@layout/section_popular_games"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Active Categories Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp24">

                    <include
                        android:id="@+id/sectionActiveCategories"
                        layout="@layout/section_active_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
        </LinearLayout>
        <!-- Modern Floating Action Button (Optional) -->

        <!-- Modern Loading Indicator -->
        <FrameLayout
            android:id="@+id/progressbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/loading_overlay_bg"
            android:clickable="true"
            android:layout_marginTop="@dimen/dp100"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary_button_bg"
                    app:trackColor="@color/progress_track_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading amazing deals..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="@dimen/dp16" />

            </LinearLayout>

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>


</androidx.drawerlayout.widget.DrawerLayout>