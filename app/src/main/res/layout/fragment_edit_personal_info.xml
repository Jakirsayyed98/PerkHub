<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".Screens.Profile.EditPersonalInfoFragment">


    <LinearLayout
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_layout" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp10"
                android:layout_marginTop="@dimen/dp15"
                app:cardElevation="@dimen/dp2"
                app:cardCornerRadius="@dimen/dp10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp20"
                    android:paddingVertical="@dimen/dp20">

                    <!-- Profile Image -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp70"
                        android:layout_height="@dimen/dp70"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/dp10"
                        app:cardBackgroundColor="@color/main2"
                        app:cardCornerRadius="@dimen/dp42"
                        app:cardElevation="4dp">

                        <!-- Name -->
                        <TextView
                            android:id="@+id/ProfilenameShort"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/dp20"
                            android:layout_marginEnd="@dimen/dp20"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sp40"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <!-- Name -->
                        <TextView
                            android:id="@+id/Profilename"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp20"
                            android:layout_marginEnd="@dimen/dp20"
                            android:text="Your Name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp20"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_marginEnd="@dimen/dp20"
                            android:orientation="horizontal">
                            <!-- Email -->
                            <TextView
                                android:id="@+id/email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp20"
                                android:layout_gravity="center_vertical"
                                android:text="your.email@example.com"
                                android:textColor="@color/grey"
                                android:textSize="@dimen/sp14" />

                            <ImageView
                                android:id="@+id/ivSecurity"
                                android:layout_width="@dimen/dp20"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="@dimen/dp5"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/verified_icon" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp5"
                            android:layout_marginEnd="@dimen/dp20"
                            android:orientation="horizontal">
                            <!-- Email -->
                            <TextView
                                android:id="@+id/number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp20"
                                android:layout_gravity="center_vertical"
                                android:text="+91 ***** *****"
                                android:textColor="@color/grey"
                                android:textSize="@dimen/sp14" />

                            <ImageView
                                android:layout_width="@dimen/dp20"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:layout_marginStart="@dimen/dp5"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/verified_icon" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/dp10"
                android:paddingHorizontal="@dimen/dp10">
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Personal Information"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    app:fontFamily="@font/poppins_bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp15" />

                <!-- ========================================= -->
                <!-- Full Name -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Full Name"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_gender_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgFullName"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="#9CA3AF" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp10"
                        android:background="@drawable/bg_gender_container"
                        android:backgroundTint="@color/white"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Enter your full name"
                        android:maxLength="50"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="56dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:textColor="@android:color/black"
                        android:textColorHint="#8E97B5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- ========================================= -->
                <!-- Email -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Email Address"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_gender_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email"
                        app:tint="#9CA3AF" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp10"
                        android:background="@drawable/bg_gender_container"
                        android:backgroundTint="@color/white"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Enter your email address"
                        android:inputType="textEmailAddress"
                        android:minHeight="56dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:textColor="@android:color/black"
                        android:textColorHint="#8E97B5"
                        android:textSize="16sp" />

                </LinearLayout>
                <!-- ========================================= -->
                <!-- Space Before Next Section -->
                <!-- ========================================= -->


                <!-- ========================================= -->
                <!-- Gender -->
                <!-- ========================================= -->

                <!-- Gender -->

                <TextView
                    android:id="@+id/tvGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Gender"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/layoutGender"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"

                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layoutMale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp5"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gender_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgMale"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_male"
                            app:tint="#18D8AE" />

                        <TextView
                            android:id="@+id/txtMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Male"
                            android:textColor="#18D8AE"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/layoutFemale"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp5"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gender_container"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgFemale"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_female"
                            app:tint="#7A7A7A" />

                        <TextView
                            android:id="@+id/txtFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Female"
                            android:textColor="#666666"
                            android:textSize="15sp" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/layoutOther"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp5"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gender_container"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgOther"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_person"
                            app:tint="#7A7A7A" />

                        <TextView
                            android:id="@+id/txtOther"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:text="Prefer\nnot to say"
                            android:textAlignment="center"
                            android:textColor="#666666"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>
                <!-- ========================================= -->
                <!-- Date Of Birth -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/tvDob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Date of Birth"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_gender_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView

                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#9CA3AF" />


                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp10"
                        android:background="@drawable/bg_gender_container"
                        android:backgroundTint="@color/white"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:hint="Select your date of birth"
                        android:inputType="none"
                        android:minHeight="56dp"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />
                </LinearLayout>
                <!-- ========================================= -->
                <!-- Security Information -->
                <!-- ========================================= -->

                <LinearLayout
                    android:id="@+id/layoutSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/border_5dp"
                    android:backgroundTint="#F1F6F4"
                    android:paddingVertical="@dimen/dp10"
                    android:paddingHorizontal="@dimen/dp10"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgSecurity"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/sheld_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSecurityTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Your data is safe with PerkHub"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvSecurityDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="We respect your privacy and only use your information to improve your experience."
                            android:textColor="#7C8798"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Space -->

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

                <!-- ========================================= -->
                <!-- Continue Button -->
                <!-- ========================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnContinue"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:layout_marginBottom="@dimen/dp100"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_continue_gradient">

                        <TextView
                            android:id="@+id/txtContinue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Save Changes"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/sp18" />

                        <ProgressBar
                            android:id="@+id/progressVerify"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            android:visibility="gone"/>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>