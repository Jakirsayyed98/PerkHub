<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/transaction_detail_bg"
    tools:context=".Screens.StoreTransaction.TransactionDetailFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_layout" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp10"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="24dp">

            <!-- ========================= -->
            <!-- TOP TRANSACTION CARD -->
            <!-- ========================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/detail_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp16">

                    <!-- Store Info + Status -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Store Logo -->

                        <androidx.cardview.widget.CardView
                            android:id="@+id/logoContainer"
                            android:layout_width="@dimen/dp60"
                            android:layout_height="@dimen/dp60"
                            app:cardCornerRadius="@dimen/dp35"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/store_logo_bg">

                            <ImageView
                                android:id="@+id/logo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp"
                                android:scaleType="centerInside" />

                        </androidx.cardview.widget.CardView>


                        <!-- Store Name -->

                        <TextView
                            android:id="@+id/storename"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/logoContainer"
                            android:layout_marginStart="16dp"
                            android:layout_alignTop="@id/logoContainer"
                            android:layout_toStartOf="@id/topStatusView"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Libas"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp16"
                            app:fontFamily="@font/poppins_bold" />

                        <!-- Status -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/topStatusView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/status_pending_bg">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/sp5"
                                android:paddingHorizontal="@dimen/sp10">

                                <ImageView
                                    android:id="@+id/topStatusIcon"
                                    android:layout_width="14dp"
                                    android:layout_height="@dimen/dp16"
                                    android:src="@drawable/outline_history_24"
                                    app:tint="@color/status_pending_text" />

                                <TextView
                                    android:id="@+id/topStatusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Pending"
                                    android:textColor="@color/status_pending_text"
                                    android:textSize="@dimen/sp13"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <!-- Ordered On -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/topStatusView"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="@dimen/dp5"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ordered on"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                            <TextView
                                android:id="@+id/orderedOn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="10 Nov, 2025 • 10:32 AM"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>

                    </RelativeLayout>


                    <!-- Transaction ID -->

                    <LinearLayout
                        android:id="@+id/transactionIdContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_transaction_id"
                        android:paddingHorizontal="@dimen/dp10"
                        android:paddingVertical="@dimen/dp5">

                        <TextView
                            android:id="@+id/transactionId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction ID: #TX29313024"
                            android:textColor="@color/transaction_id_text"
                            android:textSize="@dimen/sp13" />

                        <ImageView
                            android:id="@+id/copyTransactionId"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/section_icon_tint" />

                    </LinearLayout>


                    <!-- Divider -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/dp5"
                        android:background="@color/divider_color" />


                    <!-- Summary -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:orientation="horizontal">

                        <!-- Order Amount -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Order Amount"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp11" />

                            <TextView
                                android:id="@+id/transactionAmtTop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="₹1,318.00"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/sp14"
                                app:fontFamily="@font/poppins_semibold" />

                        </LinearLayout>


                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/dp55"
                            android:layout_marginEnd="@dimen/dp10"
                            android:background="@color/divider_color" />


                        <!-- Commission -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your Commission"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                            <TextView
                                android:id="@+id/commissionTop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="₹48.41"
                                android:textColor="@color/commission_text"
                                android:textSize="@dimen/sp14"
                                app:fontFamily="@font/poppins_semibold" />

                        </LinearLayout>


                        <View
                            android:layout_width="@dimen/dp1"
                            android:layout_height="@dimen/dp55"
                            android:layout_marginEnd="@dimen/dp10"
                            android:background="@color/divider_color" />


                        <!-- Estimated Payout -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Estimated Payout"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/sp12" />

<!--                                <ImageView-->
<!--                                    android:layout_width="18dp"-->
<!--                                    android:layout_height="18dp"-->
<!--                                    android:layout_marginStart="5dp"-->
<!--                                    android:src="@drawable/infoicon"-->
<!--                                    />-->

                            </LinearLayout>

                            <TextView
                                android:id="@+id/estimatedPayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="After return period"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ========================= -->
            <!-- TRANSACTION DETAILS -->
            <!-- ========================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/detail_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp16">

                    <!-- Header -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp22"
                            android:layout_height="@dimen/dp22"
                            android:src="@drawable/receipt"
                            app:tint="@color/section_icon_tint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp10"
                            android:text="Transaction Details"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp16"
                            app:fontFamily="@font/poppins_bold" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/divider_color" />


                    <!-- Transaction Date -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp10">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/section_icon_tint" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:text="Transaction Date"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp14" />

                        <TextView
                            android:id="@+id/transactiondate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="27 Sep, 2025"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp14"
                            app:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color" />


                    <!-- Amount -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp10">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/rupees_icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Transaction Amount"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp14" />

                        <TextView
                            android:id="@+id/transactionAmt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹1,318.00"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp14"
                            app:fontFamily="@font/poppins_semibold" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color" />


                    <!-- Commission -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp10">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/rupees_icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Your Commission"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp14" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/dp12"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/commission_bg">

                            <TextView
                                android:id="@+id/commision"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="@dimen/dp10"
                                android:paddingVertical="@dimen/dp5"
                                android:text="₹48.41"
                                android:textColor="@color/commission_text"
                                android:textSize="@dimen/sp14"
                                app:fontFamily="@font/poppins_semibold" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color" />


                    <!-- Status -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/dp10">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp12"
                            android:layout_weight="1"
                            android:text="Transaction Status"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp14" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/statusView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/status_pending_bg">

                            <TextView
                                android:id="@+id/transactionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="@dimen/dp10"
                                android:paddingVertical="@dimen/dp5"
                                android:text="Pending"
                                android:textColor="@color/status_pending_text"
                                android:textSize="@dimen/sp14"
                                app:fontFamily="@font/poppins_semibold" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ========================= -->
            <!-- TRANSACTION PROGRESS -->
            <!-- ========================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/detail_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp16">

                    <!-- Header -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/ic_progress"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Transaction Progress"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp16"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:background="@color/divider_color" />


                    <!-- STEP 1 -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/step1Icon"
                            android:layout_width="@dimen/dp45"
                            android:layout_height="@dimen/dp45"
                            app:cardCornerRadius="@dimen/dp28"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/step_completed_bg">

                            <ImageView
                                android:id="@+id/clicked"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/baseline_check_circle_24"
                                app:tint="@color/step_completed_icon" />

                        </androidx.cardview.widget.CardView>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/step1Icon"
                            android:layout_toStartOf="@id/step1StatusLayout"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Shop Clicked"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/sp14"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="You successfully clicked through to the store"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/step1StatusLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textColor="@color/step_completed_text"
                                android:textSize="@dimen/sp12"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="27 Sep, 10:31 AM"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>

                    </RelativeLayout>


                    <!-- Line -->

                    <View
                        android:layout_width="2dp"
                        android:layout_height="@dimen/dp45"
                        android:layout_marginStart="@dimen/dp27"
                        android:background="@color/progress_line_color" />


                    <!-- STEP 2 -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/step2Icon"
                            android:layout_width="@dimen/dp45"
                            android:layout_height="@dimen/dp45"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/step_completed_bg">

                            <ImageView
                                android:layout_width="@dimen/dp30"
                                android:layout_height="@dimen/dp30"
                                android:layout_gravity="center"
                                android:src="@drawable/baseline_check_circle_24"
                                app:tint="@color/step_completed_icon" />

                        </androidx.cardview.widget.CardView>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/step2Icon"
                            android:layout_toStartOf="@id/step2StatusLayout"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Transaction Tracked"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/sp14"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp4"
                                android:text="Your purchase has been successfully tracked"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/step2StatusLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textColor="@color/step_completed_text"
                                android:textSize="@dimen/sp12"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="27 Sep, 10:35 AM"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>

                    </RelativeLayout>


                    <!-- Line -->

                    <View
                        android:layout_width="2dp"
                        android:layout_height="@dimen/dp45"
                        android:layout_marginStart="27dp"
                        android:background="@color/progress_line_color" />


                    <!-- STEP 3 -->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/step3Icon"
                            android:layout_width="@dimen/dp45"
                            android:layout_height="@dimen/dp45"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/status_pending_bg">

                            <ImageView
                                android:id="@+id/icon"
                                android:layout_width="@dimen/dp30"
                                android:layout_height="@dimen/dp30"
                                android:layout_gravity="center"
                                android:src="@drawable/outline_history_24"
                                app:tint="@color/status_pending_text" />

                        </androidx.cardview.widget.CardView>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/step3Icon"
                            android:layout_toStartOf="@id/step3StatusLayout"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Transaction in Pending"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/sp14"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/statusDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp4"
                                android:text="Commission will be credited to your account"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/step3StatusLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/progressStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending"
                                android:textColor="@color/status_pending_text"
                                android:textSize="@dimen/sp12"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/progressDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="After return period"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/sp12" />

                        </LinearLayout>

                    </RelativeLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ========================= -->
            <!-- NEED HELP CARD -->
            <!-- ========================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/helpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp20"
                android:layout_marginTop="@dimen/dp10"
                app:cardElevation="1dp"
                android:layout_marginBottom="@dimen/dp10"
                app:cardBackgroundColor="@color/help_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp16">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp45"
                        android:layout_height="@dimen/dp45"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/step_completed_bg">

                        <ImageView
                            android:layout_width="@dimen/dp30"
                            android:layout_height="@dimen/dp30"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_help"
                            app:tint="@color/section_icon_tint" />

                    </androidx.cardview.widget.CardView>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Need help?"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/sp14"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Visit our Help Center for more information"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/sp12" />

                    </LinearLayout>


                    <ImageView
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:src="@drawable/arrow_right"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>