<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/transaction_detail_bg"
    tools:context=".Screens.StoreTransaction.TransactionDetailFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_layout" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp16"
            android:paddingBottom="@dimen/dp24">

            <!-- Store Header Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="@dimen/dp6"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp16"
                    android:gravity="center_horizontal">

                    <!-- Store Logo with Modern Styling -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/dp60"
                        android:layout_height="@dimen/dp60"
                        app:cardCornerRadius="@dimen/dp20"
                        app:cardElevation="@dimen/dp4"
                        app:cardBackgroundColor="@color/store_logo_bg"
                        app:strokeColor="@color/store_logo_stroke"
                        app:strokeWidth="2dp"
                        android:layout_marginBottom="@dimen/dp16">

                        <ImageView
                            android:id="@+id/logo"
                            android:layout_width="@dimen/dp48"
                            android:layout_height="@dimen/dp48"
                            android:layout_gravity="center"
                            android:scaleType="centerInside" />

                    </androidx.cardview.widget.CardView>

                    <!-- Store Name -->
                    <TextView
                        android:id="@+id/storename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store Name"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/dp8" />

                    <!-- Transaction ID Badge -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/dp12"
                        app:cardElevation="@dimen/dp1"
                        app:cardBackgroundColor="@color/transaction_id_bg">

                        <TextView
                            android:id="@+id/transactionId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction #TXN001"
                            android:textColor="@color/transaction_id_text"
                            android:textSize="12sp"
                            android:paddingHorizontal="@dimen/dp12"
                            android:paddingVertical="@dimen/dp4" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Transaction Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="@dimen/dp4"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/detail_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp20">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/dp16">

                        <ImageView
                            android:layout_width="@dimen/dp24"
                            android:layout_height="@dimen/dp24"
                            android:src="@drawable/receipt"
                            app:tint="@color/section_icon_tint"
                            android:layout_marginEnd="@dimen/dp8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction Details"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Transaction Date Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/dp12"
                        >

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/baseline_check_circle_24"
                            app:tint="@color/green"
                            android:layout_marginEnd="@dimen/dp12"
                            android:layout_marginStart="@dimen/dp4" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Transaction Date"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                             />

                        <TextView
                            android:id="@+id/transactiondate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct 13, 2024"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="@dimen/dp8" />

                    <!-- Transaction Amount Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/dp12"
                        >

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/rupees_icon"
                            android:layout_marginEnd="@dimen/dp12"
                            android:layout_marginStart="@dimen/dp4" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Transaction Amount"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                             />

                        <TextView
                            android:id="@+id/transactionAmt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹500.00"
                            android:textColor="@color/amount_text_color"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="@dimen/dp8" />

                    <!-- Commission Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/dp12"
                        >

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/rupees_icon"
                            android:layout_marginEnd="@dimen/dp12"
                            android:layout_marginStart="@dimen/dp4" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your Commission"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                             />

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/dp8"
                            app:cardElevation="@dimen/dp1"
                            app:cardBackgroundColor="@color/commission_bg">

                            <TextView
                                android:id="@+id/commision"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹25.00"
                                android:textColor="@color/commission_text"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="@dimen/dp8"
                                android:paddingVertical="@dimen/dp4" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="@dimen/dp8" />

                    <!-- Status Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/dp12"
                        >

                        <ImageView
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:src="@drawable/outline_history_24"
                            app:tint="@color/detail_icon_tint"
                            android:layout_marginEnd="@dimen/dp12"
                            android:layout_marginStart="@dimen/dp4" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Transaction Status"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                             />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/statusView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/dp12"
                            app:cardElevation="@dimen/dp1"
                            app:cardBackgroundColor="@color/status_verified_bg">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="@dimen/dp10"
                                android:paddingVertical="@dimen/dp6">

                                <TextView
                                    android:id="@+id/transactionstatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Verified"
                                    android:textColor="@color/status_verified_text"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Transaction Progress Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                app:cardCornerRadius="@dimen/dp20"
                app:cardElevation="@dimen/dp4"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/detail_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp20">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/dp20">

                        <ImageView
                            android:layout_width="@dimen/dp24"
                            android:layout_height="@dimen/dp24"
                            android:src="@drawable/receipt"
                            app:tint="@color/section_icon_tint"
                            android:layout_marginEnd="@dimen/dp8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transaction Progress"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Progress Steps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Step 1: Shop Clicked -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="@dimen/dp12">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                app:cardCornerRadius="@dimen/dp20"
                                app:cardElevation="@dimen/dp2"
                                app:cardBackgroundColor="@color/step_completed_bg"
                                android:layout_marginEnd="@dimen/dp16">

                                <ImageView
                                    android:id="@+id/clicked"
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    app:tint="@color/step_completed_icon" />

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shop Clicked"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="You successfully clicked through to the store"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="@dimen/dp2" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textColor="@color/step_completed_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Progress Line -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="@dimen/dp20"
                            android:background="@color/progress_line_color"
                            android:layout_marginStart="@dimen/dp19" />

                        <!-- Step 2: Transaction Tracked -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="@dimen/dp12">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                app:cardCornerRadius="@dimen/dp20"
                                app:cardElevation="@dimen/dp2"
                                app:cardBackgroundColor="@color/step_completed_bg"
                                android:layout_marginEnd="@dimen/dp16">

                                <ImageView
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    app:tint="@color/step_completed_icon" />

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Transaction Tracked"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Your purchase has been successfully tracked"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="@dimen/dp2" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textColor="@color/step_completed_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Progress Line -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="@dimen/dp20"
                            android:background="@color/progress_line_color"
                            android:layout_marginStart="@dimen/dp19" />

                        <!-- Step 3: Transaction Verified -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="@dimen/dp12">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                app:cardCornerRadius="@dimen/dp20"
                                app:cardElevation="@dimen/dp2"
                                app:cardBackgroundColor="@color/step_completed_bg"
                                android:layout_marginEnd="@dimen/dp16">

                                <ImageView
                                    android:id="@+id/icon"
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    app:tint="@color/step_completed_icon" />

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Transaction Verified"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Commission will be credited to your account"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:layout_marginTop="@dimen/dp2" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textColor="@color/step_completed_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>