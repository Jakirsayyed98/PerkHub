<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".Screens.Home.TransactionDetailFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_layout"/>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp30"
                android:layout_marginBottom="@dimen/dp10"
                app:cardElevation="@dimen/dp5"
                app:cardCornerRadius="@dimen/dp10">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp50"
                />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/storename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/dp5"
                android:text="Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:padding="5dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/dp5"
                android:text="Transaction Detail"
                android:paddingStart="10dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="5dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Transaction Date"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/transactiondate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:text=""
                    android:paddingEnd="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Transaction Amount"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/transactionAmt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:text=""
                    android:paddingEnd="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Your Commision"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/commision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:text=""
                    android:paddingEnd="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Transaction Status"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/transactionstatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:text=""
                    android:paddingEnd="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="Transaction Status View"
                    android:paddingStart="10dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Shop Clicked"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/clicked"
                    android:layout_width="@dimen/dp25"
                    android:layout_height="@dimen/dp25"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:src="@drawable/baseline_check_circle_24"
                    app:tint="@color/green"
                    android:layout_marginEnd="@dimen/dp25"
                    android:textSize="14sp"
                    android:textStyle="bold"
                     />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Transaction Tracked"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="@dimen/dp25"
                    android:layout_height="@dimen/dp25"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:src="@drawable/baseline_check_circle_24"
                    app:tint="@color/green"
                    android:layout_marginEnd="@dimen/dp25"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>





            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="Transaction Verified"
                    android:paddingStart="10dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/dp25"
                    android:layout_height="@dimen/dp25"
                    android:textColor="@color/black"
                    android:textAlignment="textEnd"
                    android:layout_marginTop="@dimen/dp5"
                    android:src="@drawable/baseline_check_circle_24"
                    android:layout_marginEnd="@dimen/dp25"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>







        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</LinearLayout>