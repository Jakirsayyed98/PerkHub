<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/dp20"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp15">

        <!-- Top Row : Date + Status -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/TxnDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Jun, 2026"
                android:textColor="@color/black"
                android:textSize="@dimen/sp12"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/statusView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                app:cardBackgroundColor="#FFF6D8"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/statusBg"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp8"
                    android:paddingVertical="@dimen/dp5">

                    <ImageView
                        android:id="@+id/statusIcon"
                        android:layout_width="@dimen/dp14"
                        android:layout_height="@dimen/dp14"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="#8A5A12" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp5"
                        android:text="Pending"
                        android:textColor="#6B4A14"
                        android:textSize="@dimen/sp12"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>


        <!-- Store Details -->

        <LinearLayout
            android:id="@+id/namelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/dp55"
                android:layout_height="@dimen/dp55"
                app:cardCornerRadius="@dimen/dp40"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/storeIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dp15"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/storeName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Libas"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp15"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/TxnID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#29313132"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp14"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/copyTxnId"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:layout_marginStart="18dp"
                        android:contentDescription="Copy Transaction ID"
                        android:src="@drawable/ic_copy"
                        app:tint="#238553" />

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>


        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dp5"
            android:background="#E8E8E8" />


        <!-- Amount + Cashback -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:orientation="horizontal">

            <!-- Order Amount -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Amount"
                    android:textColor="#5F6570"
                    android:textSize="@dimen/sp10" />

                <TextView
                    android:id="@+id/SaleAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="₹00.00"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Vertical Divider -->

            <View
                android:layout_width="1dp"
                android:layout_height="@dimen/dp45"
                android:layout_gravity="center_vertical"
                android:background="#E0E0E0" />


            <!-- Cashback -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cashback"
                    android:textColor="#5F6570"
                    android:textSize="@dimen/sp10" />

                <TextView
                    android:id="@+id/commision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="₹00.00"
                    android:textColor="#238553"
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginTop="@dimen/dp5"
            android:background="#E8E8E8" />


        <!-- Order Tracking -->

        <LinearLayout
            android:id="@+id/orderTrackingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/trackingIconBG"
                android:layout_width="@dimen/dp45"
                android:layout_height="@dimen/dp45"
                app:cardBackgroundColor="#EAF7F0"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/trackingIcon"
                    android:layout_width="@dimen/dp28"
                    android:layout_height="@dimen/dp28"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/store_orders" />

            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trackingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Tracked"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/trackingDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:maxLines="1"
                    android:text="We'll update you as soon as there's progress"
                    android:textColor="#6E7480"
                    android:textSize="@dimen/dp12" />

            </LinearLayout>


            <ImageView
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:contentDescription="View Details"
                android:src="@drawable/arrow_right"
                app:tint="#6E7480" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>