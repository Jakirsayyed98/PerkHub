<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#D97706"
                android:endColor="#DC2626"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/cta_gradient_start"
                android:endColor="@color/cta_gradient_end"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>